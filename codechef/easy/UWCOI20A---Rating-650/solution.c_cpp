#include <stdio.h>

void maximum(int *arr, int N);


int main ()
{
    int T, N;
    int j = 0;
    
    scanf("%d", &T);

    while(j < T)
        {
            int i = 0;
            scanf("%d", &N);

            int arr[100000];

                while(i < N)
                {
                    scanf("%d", &arr[i]);
                    ++i;
                }

            maximum(arr, N);
            ++j;
        }

    return 0;
}


void maximum(int *arr, int N)
{
    int Max = arr[0];

    int i = 1;

    while(i < N)
    {
        if(Max < arr[i])
        {
            Max = arr[i];
        }
        ++i;
    }

    printf("%d\n", Max);
}
