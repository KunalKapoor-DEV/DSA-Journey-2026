int countNonMinimum(int a[], int n) {
    
    int Mini = a[0];

    for(int i = 0; i < n; ++i)
    {
        if(Mini > a[i])
        {
            Mini = a[i];
        }
    }

    int i = 0;
    int count = 0;

    while(i < n)
    {
        if(Mini < a[i])
        {
            count++;
        }
        ++i;
    }

    return count;
}

