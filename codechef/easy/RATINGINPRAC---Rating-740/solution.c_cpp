#include <stdio.h>

void rating (int d[], int n);

int main() {
    int t;
    scanf("%d", &t);

    while (t--) 
    {
        int n;
        scanf("%d", &n);
        int d[n];
        
        for (int i = 0; i < n; i++) {
            scanf("%d", &d[i]);
        }
        
        rating(d, n);
    }
}

void rating (int d[], int n)
{
    int i = 0;
    int temp = 0;

    while(i < n-1)
    {

        if(d[i] > d[i+1])
        {
            printf("NO\n");
            return;
        }
        ++i;
    }
    printf("YES\n");
}